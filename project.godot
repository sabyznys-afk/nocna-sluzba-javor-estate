config_version=5

[application]

config/name="NIGHT SHIFT: THE JAVOR ESTATE (NOČNÁ SLUŽBA)"
config/description="1996 Central European Psychological Horror — Sídlisko Javor, Nový Brod"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

LocalizationManager="*res://scripts/autoload/localization_manager.gd"
